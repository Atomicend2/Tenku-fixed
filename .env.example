# ============================================================
# TENKU BOT - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Owner phone numbers (comma-separated, no + or spaces, E.164 digits only)
# Example: 2348144550593,2341234567890
OWNER_NUMBERS=2348144550593

# Gemini API Key (for .ubs bulk card upload via AI)
GEMINI_API_KEY=AIzaSyBReuOcZFsIGrrmyvozHBg809HmuORDHCw

# JWT Secret for website authentication (use a long random string)
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# Database (SQLite path or PostgreSQL URL)
DATABASE_URL=file:./tenku.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/tenku

# Server port
PORT=3000

# Node environment
NODE_ENV=production

# Session directory for Baileys WhatsApp sessions
SESSION_DIR=./sessions

# Optional: OTP email settings (for website registration OTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=yourpassword
